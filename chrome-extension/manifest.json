{
    "manifest_version":  3,
    "name":  "GptApiYar Local Demo Connector",
    "version":  "0.3.1",
    "description":  "Connect the user-selected local demo tab in the current Chrome to GptApiYar. No ChatGPT access.",
    "permissions":  [
                        "tabs",
                        "storage"
                    ],
    "host_permissions":  [
                             "http://127.0.0.1/*"
                         ],
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "GptApiYar"
               },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "http://127.0.0.1/demo.html*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle",
                                "all_frames":  false
                            },
                            {
                                "run_at":  "document_start",
                                "all_frames":  false,
                                "matches":  [
                                                "http://127.0.0.1/*"
                                            ],
                                "js":  [
                                           "ui-bridge.js"
                                       ]
                            },
                            {
                                "run_at":  "document_start",
                                "all_frames":  false,
                                "matches":  [
                                                "http://127.0.0.1/*",
                                                "http://localhost/*"
                                            ],
                                "js":  [
                                           "ui-tabs.js"
                                       ]
                            }
                        ],
    "background":  {
                       "service_worker":  "background.js"
                   }
}